# Copy to .env (or run `npm run setup` to generate one with fresh secrets).

# 32 random bytes, base64. Encrypts all sensitive fields and receipt files at rest.
# LOSING THIS KEY MEANS LOSING YOUR DATA. Back it up somewhere safe (password manager).
ENCRYPTION_KEY=

# Network
PORT=3000
HOST=127.0.0.1          # use 0.0.0.0 to accept connections from other machines / Docker

# Set to true when running behind a reverse proxy that terminates HTTPS (Caddy, nginx, Railway, Fly).
TRUST_PROXY=false
# Force the Secure flag on cookies even if the proxy doesn't send X-Forwarded-Proto (recommended in production).
SECURE_COOKIES=false

# After the first account is created, can strangers still sign up and create *new* companies?
# Keep false for a private deployment: new people join only through invite links.
ALLOW_OPEN_SIGNUP=false

# Where the SQLite database and encrypted receipts live.
DATA_DIR=./data

# Public URL used to build invite links (e.g. https://keel.example.com). Optional.
APP_URL=
